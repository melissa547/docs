{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Arrays",
  "description": "Unified financial data engine for AI agents and developers — equities, crypto, ETF, macro, and on-chain data through one API.",
  "colors": {
    "primary": "#121212",
    "light": "#fafafa",
    "dark": "#121212"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://arrays.org"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "welcome",
              "quickstart"
            ]
          },
          {
            "group": "Nanopayment",
            "pages": [
              "nanopayment/overview",
              "nanopayment/quickstart"
            ]
          },
          {
            "group": "Plans",
            "pages": [
              "pricing"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      },
      {
        "tab": "Skills",
        "groups": [
          {
            "group": "AI Agent Hub",
            "pages": [
              "skills/overview",
              "skills/install-claude-code",
              "skills/install-cursor",
              "skills/install-codex",
              "skills/prompts"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Skills Repo on GitHub",
          "href": "https://github.com/ArraysData/arrays-skills",
          "icon": "github"
        },
        {
          "anchor": "Swagger API Explorer",
          "href": "https://data-tools.prd.arrays.org/swagger/index.html",
          "icon": "code"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "/pricing"
      },
      {
        "label": "Support",
        "href": "mailto:support@arrays.org"
      },
      {
        "label": "Dashboard",
        "href": "https://arrays.org"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://arrays.org"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ArraysData",
      "website": "https://arrays.org"
    }
  },
  "fonts": {
    "family": "Plus Jakarta Sans"
  },
  "seo": {
    "metatags": {
      "og:image": "/images/og.png",
      "twitter:card": "summary_large_image"
    }
  }
}
